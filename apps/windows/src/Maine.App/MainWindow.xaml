<Window x:Class="Maine.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Maine.App"
        Title="Maine" Width="1100" Height="720" MinWidth="760" MinHeight="480">
  <Window.Resources>
    <local:IndentToMarginConverter x:Key="IndentConverter" />
    <BooleanToVisibilityConverter x:Key="BoolVisConverter" />
    <Style x:Key="SidebarRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Host">
        <MenuItem x:Name="NewHostItem" Header="_New Host" InputGestureText="Ctrl+N" Click="OnNewHost" />
        <MenuItem x:Name="UnlockItem" Header="_Unlock Password Vault" Click="OnUnlock" />
        <MenuItem x:Name="LockItem" Header="_Lock Password Vault" Click="OnLock" />
        <Separator />
        <MenuItem x:Name="ShowVaultItem" Header="_Show Encrypted Vault" Click="OnShowVault" />
      </MenuItem>
      <MenuItem Header="_Session">
        <MenuItem x:Name="NewSessionItem" Header="_New Session" Click="OnNewSession" />
        <MenuItem x:Name="ReconnectItem" Header="_Reconnect" InputGestureText="Shift+Ctrl+R" Click="OnReconnect" />
        <MenuItem x:Name="CloseSessionItem" Header="_Close Session" InputGestureText="Shift+Ctrl+W" Click="OnCloseSession" />
      </MenuItem>
    </Menu>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="200" MaxWidth="420" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar: hosts with indented session rows. Single click connects. -->
      <DockPanel Grid.Column="0">
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="8,8,8,4"
                 TextChanged="OnSearchChanged" />
        <Button DockPanel.Dock="Bottom" Margin="8" Content="New Host (Ctrl+N)" Click="OnNewHost" />
        <ListBox x:Name="Sidebar" Margin="8,4,8,8"
                 ItemsSource="{Binding SidebarItems}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource SidebarRow}"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnSidebarDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="{Binding Indent, Converter={StaticResource IndentConverter}}">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="0" Width="4" HorizontalAlignment="Right"
                    Background="Transparent" />

      <!-- Content: compact header, terminal, error banner. -->
      <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
          <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button x:Name="ReconnectButton" Content="Reconnect" Margin="0,0,8,0"
                      Click="OnReconnect" />
              <Button x:Name="CloseButton" Content="Close" Click="OnCloseSession" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding HeaderEndpoint}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding HeaderEndpoint}" />
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="Gray"
                       x:Name="StatusDot" />
                <TextBlock Text="{Binding HeaderStatus}" Opacity="0.7" FontSize="12" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFFDE7CC" Padding="12,8"
                Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolVisConverter}}">
          <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="TerminalHost" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
