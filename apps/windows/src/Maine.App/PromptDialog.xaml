<Window x:Class="Maine.App.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maine" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
    <PasswordBox x:Name="AnswerBox" Margin="0,0,0,12" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="Continue" Width="80" IsDefault="True" Click="OnOk" />
    </StackPanel>
  </StackPanel>
</Window>
